# =============================================================================
# AI Orchestrator — example environment file
# Copy to `.env` and fill in. NEVER commit your real `.env`.
#
# Generate strong secrets with:
#   openssl rand -base64 32
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace

# --- API server ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=11435                      # Orchestrator port (Ollama itself uses 11434)
# Set true when the API runs behind a reverse proxy (nginx/Traefik) so that
# client IPs are read from X-Forwarded-* headers.
TRUST_PROXY=true
REQUEST_TIMEOUT_MS=300000           # Max time for a single upstream inference (5 min)

# --- Database (PostgreSQL + TimescaleDB) -----------------------------------
DATABASE_URL=postgres://orchestrator:change-me-in-prod@localhost:5432/orchestrator
# Used by docker-compose to provision the database container:
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=orchestrator

# --- Security: secrets-at-rest & auth --------------------------------------
# 32-byte key (base64) used to encrypt provider credentials at rest (AES-256-GCM).
ORCHESTRATOR_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
# Secret used to sign dashboard JWTs.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_ACCESS_TTL=900                  # access token lifetime (seconds) = 15 min
JWT_REFRESH_TTL=2592000             # refresh token lifetime (seconds) = 30 days

# --- CORS / dashboard ------------------------------------------------------
# Comma-separated list of allowed dashboard origins.
DASHBOARD_ORIGIN=http://localhost:8080

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=600                  # requests per window per client
RATE_LIMIT_WINDOW=60000             # window in ms (1 min)

# --- Orchestrator behaviour ------------------------------------------------
# round-robin | weighted | least-connections | least-latency
DEFAULT_STRATEGY=least-connections
HEALTHCHECK_INTERVAL_MS=10000
HEALTHCHECK_TIMEOUT_MS=3000
NODE_FAILOVER_RETRIES=2

# Cloud provider credentials (Anthropic / OpenAI / xAI / Bedrock) are NOT set
# here — add them through the dashboard so they are encrypted at rest.
