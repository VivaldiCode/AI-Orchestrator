{
  "name": "@ai-orchestrator/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Orchestrator backend — mirrors the Ollama API and load-balances across nodes and cloud providers.",
  "license": "MIT",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
