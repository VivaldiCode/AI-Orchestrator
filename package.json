{
  "name": "ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted gateway that mirrors the Ollama API and load-balances inference across your Macs and cloud AI providers.",
  "license": "MIT",
  "author": "VivaldiCode <guilhermecamachop@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/VivaldiCode/ollama-orquestrator",
  "repository": {
    "type": "git",
    "url": "https://github.com/VivaldiCode/ollama-orquestrator.git"
  },
  "keywords": [
    "ollama",
    "llm",
    "load-balancer",
    "ai-gateway",
    "reverse-proxy",
    "self-hosted",
    "open-source"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:dashboard",
    "dev:api": "npm run dev -w @ai-orchestrator/api",
    "dev:dashboard": "npm run dev -w @ai-orchestrator/dashboard",
    "build": "npm run build -w @ai-orchestrator/dashboard",
    "start": "npm run start -w @ai-orchestrator/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-test.mjs",
    "db:migrate": "npm run db:migrate -w @ai-orchestrator/api",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "clean:dotfiles": "find . -name node_modules -prune -o -name '._*' -type f -print -delete",
    "compose:up": "npm run clean:dotfiles && docker compose up -d --build",
    "compose:up:test": "npm run clean:dotfiles && docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --build",
    "compose:rebuild": "npm run clean:dotfiles && docker compose down && docker compose up -d --build --force-recreate",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
